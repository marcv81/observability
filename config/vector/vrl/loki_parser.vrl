# Remove keys with empty values, they confuse parse_logfmt.
.message = replace!(.message, r'\S+=\s', "")
.metadata.loki = parse_logfmt!(.message)

.message = .metadata.loki.msg
del(.metadata.loki.msg)

t = parse_timestamp!(.metadata.loki.ts, format: "%+")
.timestamp = to_unix_timestamp(t, "nanoseconds")
del(.metadata.loki.ts)

row = get_enrichment_table_record!(
	table: "otel_severity",
	condition: {"severity_text": .metadata.loki.level},
	case_sensitive: false,
)
.severity_number = row.severity_number
.severity_text = .metadata.loki.level
del(.metadata.loki.level)
